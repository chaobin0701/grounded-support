POSTGRES_DB=grounded_support
POSTGRES_USER=grounded
POSTGRES_PASSWORD=replace-with-a-local-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=grounded-support
JWT_AUDIENCE=grounded-support-admin
JWT_EXPIRES_IN_SECONDS=900
UPLOAD_ROOT=/data/uploads
TRUST_PROXY=1
# Comma-separated browser origins allowed to make state-changing requests.
ALLOWED_ORIGINS=http://localhost:8081
CHAT_RATE_WINDOW_MS=60000
CHAT_RATE_LIMIT=10
CHAT_CONCURRENCY=5
ADMIN_LOGIN_RATE_WINDOW_MS=60000
ADMIN_LOGIN_RATE_LIMIT=5
DOCUMENT_UPLOAD_RATE_WINDOW_MS=60000
DOCUMENT_UPLOAD_RATE_LIMIT=50
DOCUMENT_UPLOAD_CONCURRENCY=2
WEB_PORT=8081
POSTGRES_PORT=5433
# Optional: leave empty for lexical-only search. Do not commit the API key.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_MODEL=doubao-embedding-vision-251215
# Optional approved provider connections; keep real API keys only in local .env.
# {"secondary":{"baseUrl":"https://your-provider.example/v1","apiKey":"..."}}
EMBEDDING_CONNECTIONS_JSON=
# Server-side answer model. Never commit the real key.
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=deepseek-v4-1-flash-260910
LLM_TIMEOUT_MS=20000
LLM_CONTEXT_WINDOW_TOKENS=32000
LLM_MAX_OUTPUT_TOKENS=1200
# Structured Planner output: auto sends JSON mode and retries without it when an endpoint rejects the parameter.
LLM_STRUCTURED_OUTPUT=auto
