# Copy to /opt/hexu-support/.env.production; never commit the real file.
SERVER_IMAGE=hexu-server:release-tag
EDGE_IMAGE=hexu-edge:release-tag
POSTGRES_IMAGE=pgvector/pgvector:pg17
POSTGRES_DB=grounded_support
POSTGRES_USER=hexu
POSTGRES_PASSWORD=generate-a-new-production-password
DATABASE_URL=postgres://hexu:generate-a-new-production-password@postgres:5432/grounded_support
JWT_SECRET=generate-a-new-production-login-secret
# When migrating old encrypted profiles, preserve their effective encryption source.
MODEL_CONFIG_ENCRYPTION_KEY=the-original-effective-model-encryption-secret
JWT_ISSUER=grounded-support
JWT_AUDIENCE=grounded-support-admin
JWT_EXPIRES_IN_SECONDS=900
WEBSITE_DOMAIN=hexu.7410000.xyz
ADMIN_DOMAIN=hexu-admin.7410000.xyz
EDGE_BIND_IP=127.0.0.1
ALLOWED_ORIGINS=https://hexu.7410000.xyz,https://hexu-admin.7410000.xyz
UPLOAD_ROOT=/data/uploads
PORT=3000
TRUST_PROXY=1
CHAT_CONCURRENCY=2
CHAT_RATE_WINDOW_MS=60000
CHAT_RATE_LIMIT=10
DOCUMENT_UPLOAD_CONCURRENCY=1
DOCUMENT_UPLOAD_RATE_LIMIT=20
ADMIN_LOGIN_RATE_LIMIT=5
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=deepseek-v4-1-flash-260910
LLM_TIMEOUT_MS=20000
LLM_CONTEXT_WINDOW_TOKENS=32000
LLM_MAX_OUTPUT_TOKENS=1200
LLM_ALLOWED_BASE_URLS=https://ark.cn-beijing.volces.com/api/v3,https://api.openai.com/v1,https://api.deepseek.com/v1
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_MODEL=doubao-embedding-vision-251215
EMBEDDING_ALLOWED_BASE_URLS=https://ark.cn-beijing.volces.com/api/v3,https://api.openai.com/v1
EMBEDDING_CONNECTIONS_JSON=
