{
  "name": "grounded-support-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "db:migrate": "node-pg-migrate up -m migrations --no-verbose",
    "start:api": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "admin:bootstrap": "node dist/admin/bootstrap.js",
    "samples:prepare": "node scripts/prepare-sample-knowledge.mjs",
    "samples:reprocess": "node scripts/reprocess-sample-knowledge.mjs",
    "documents:reindex": "node scripts/reindex-all-documents.mjs",
    "eval:retrieval": "node scripts/evaluate-retrieval.mjs"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.0.3",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.2",
    "markdown-it": "^15.0.2",
    "multer": "^2.4.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "pg-boss": "^12.33.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "typescript": "~5.9.3"
  }
}
